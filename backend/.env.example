DEPLOYMENT_MODE=development
DATABASE_URL=mysql+pymysql://gate:CHANGE_ME@127.0.0.1:3306/gate_module
CAMERAS_FILE=config/cameras.yaml
CAMERA_1_RTSP=
CAMERA_2_RTSP=
CAMERA_3_RTSP=
CAMERA_4_RTSP=
PIPELINE_ENABLED=false
MODEL_BACKEND=pytorch
MODEL_PATH=../runs/detect/gate_detector/weights/best.pt
MODEL_DEVICE=cpu
OCR_ENGINE=easyocr
OCR_GPU=false
OCR_DOWNLOAD_ENABLED=false
OCR_MODEL_DIRECTORY=models/easyocr
CLASS_ALIASES={"cointainer":"container"}
TARGET_CLASSES=["container","trailer","truck","vehicle"]
OCR_CLASSES=["container","trailer"]
INFERENCE_FPS=3
CONFIDENCE_THRESHOLD=0.35
OCR_MIN_CONFIDENCE=0.6
MIN_TRACK_HITS=3
OCR_CONFIRMATIONS=2
OCR_MAX_ATTEMPTS=4
OCR_INTERVAL_SECONDS=1
OCR_QUEUE_SIZE=8
DEDUP_SECONDS=30
TRACK_TTL_SECONDS=5
SNAPSHOT_DIRECTORY=snapshots
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_MB=2048
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Prosper Smart Yard Cloud Sync
PROSPER_ENABLED=false
PROSPER_API_BASE_URL=http://syapi.prosperassettracking.com
PROSPER_SITE_ID=
PROSPER_API_KEY=
PROSPER_BEARER_TOKEN=
PROSPER_SITE_CODE=
PROSPER_EMAIL=
PROSPER_PASSWORD=
PROSPER_DEVICE_UUID=
